# CoordinaTech — variables de entorno (copiar a .env.local; nunca commitear valores reales)
# Gestión por ambiente (desarrollo / pruebas / producción) en Vercel y Supabase — Informe Final, Tabla 27.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Acceso administrador de demo (ver docs/proyecto-titulo/BRECHAS.md B-02: expuesto al cliente, reemplazar por Supabase Auth)
NEXT_PUBLIC_ADMIN_EMAIL=
NEXT_PUBLIC_ADMIN_NAME=
NEXT_PUBLIC_ADMIN_PASSWORD=
NEXT_PUBLIC_DEMO_2FA_CODE=

# Correo (src/app/api/send-email) — configurar solo uno de los proveedores
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_USER=
EMAIL_PASSWORD=
